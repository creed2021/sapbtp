<mvc:View xmlns:smartfilterbar="sap.ui.comp.smartfilterbar"
    controllerName="curso.project1.controller.smartView2"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.f"
    xmlns:smarttable="sap.ui.comp.smarttable"
>
    <Page
        id="pagesmart2"
        title="{i18n>titleE}"
    >
        <content>
            <f:DynamicPage>
                <f:title>
                    <f:DynamicPageTitle>
                        <f:heading>
                            <Title text="{i18n>appTitleE}" />
                        </f:heading>
                    </f:DynamicPageTitle>
                </f:title>
                <f:header>
                
                <f:DynamicPageHeader>
                <smartfilterbar:SmartFilterBar id="filtro2" entitySet="Employees">
                </smartfilterbar:SmartFilterBar>
                </f:DynamicPageHeader>

                </f:header>
                <f:content>
                <smarttable:SmartTable 
                    id="smarttable_table2"
                    enableAutoBinding="true"
                    entitySet="Employees"
                    smartFilterId="filtro2"
>   
                
                </smarttable:SmartTable>
                </f:content>
            </f:DynamicPage>
        </content>
    </Page>
</mvc:View>
